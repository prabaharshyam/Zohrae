# Copy to .env.local (never commit .env.local).

# Mock catalogue until the Shopify store is connected (Phase 4).
USE_MOCK_DATA=true

# Shopify Headless sales channel → Storefront API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=

# Public site URL (used for metadata / OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp concierge, international format without + (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Shown in the footer once available
NEXT_PUBLIC_GSTIN=

# Cloudinary signed uploads for wedding photo magnets (Phase 5)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
